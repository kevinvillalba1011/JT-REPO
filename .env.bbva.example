# Variables de la instancia BBVA (docker-compose.bbva.yml). Copiar a .env.bbva.
# .env.bbva NO se sube a git.

# Puerto del host donde queda publicado (davibank usa 3000)
BBVA_APP_PORT=3001

# BD propia del modelo de IA de BBVA (la que tiene la migracion MANUAL_OK)
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:5432/NOMBRE_BD_BBVA

# Perfil: bbva = extraccion a demanda del portal B2B
TENANT_PROFILE=bbva

# Clave de Gemini y header X-Api-Key que debe mandar el portal
# (en el portal: parametro ia_extraccion_api_key)
GEMINI_API_KEY=
EXTRACTION_MANUAL_API_KEY=

# Obligatorias en la validacion de arranque aunque BBVA no use Document AI;
# se pueden repetir los valores de davibank
GCP_PROJECT_ID=
GCP_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=

GEMINI_FALLBACK_MODELS="gemini-2.5-flash,gemini-2.5-pro,gemini-2.0-flash"
GEMINI_INLINE_MAX_MB=15
FILE_MAX_SIZE_MB=20

# Esta instancia no ingiere carpetas: el barrido de entrada corre una vez al dia
CRON_EXTRACTION_SCHEDULE="0 0 3 * * *"
CRON_REPORT_SCHEDULE="0 23 * * *"
CRON_ENTRY_REPORT_SCHEDULE=0 * * * *

LOG_LEVELS=error,warn,verbose
