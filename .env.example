# 1. System Configuration
PORT=3000
NODE_ENV=development

# 2. Infrastructure
DATABASE_URL=postgresql://user:pass@host:port/db
REDIS_HOST=localhost
REDIS_PORT=6379

# 3. Paths Configuration
IN_PATH=./local/in
OCR_PATH=./local/ocr
# Final destination for processed Excel/CSV bulk files (outside the project)
EXCEL_DESTINATION_PATH=./local/excel-done
# Final destination for processed OCR/PDF documents (outside the project)
OCR_DESTINATION_PATH=./local/ocr-done
# Host paths on your server (Change these to your real server paths)
SERVER_PATH_1=./local/source1
SERVER_PATH_2=./local/source2
SERVER_PATH_3=./local/source3

# Internal container paths for the app (Mapped in docker-compose.yml)
LOCAL_SOURCE_PATHS=/app/source/1,/app/source/2,/app/source/3
LOCAL_CLIENTS_PATH=./local/data
LOCAL_REPORTS_PATH=./local/reports

# 4. Pipeline Settings
CRON_EXTRACTION_SCHEDULE="*/1 * * * *"
CRON_REPORT_SCHEDULE="0 23 * * *"
ALLOWED_EXTENSIONS=.doc,.pdf,.csv,.png,.jpg,.xls
CSV_CLIENTS_FILE=clients.csv

# 5. AI Services
GCP_PROJECT_ID=project-id
GCP_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=processor-id
GOOGLE_APPLICATION_CREDENTIALS=./secrets/key.json
GEMINI_API_KEY=key
GEMINI_FALLBACK_MODELS="gemini-2.5-flash,gemini-2.5-pro,gemini-2.0-flash"

# 6. Queue Workers & Rate Limits
MODEL_QUEUE_CONCURRENCY=2
MODEL_QUEUE_RPM_LIMIT=15

# 7. External Integration Settings
# URL to obtain bearer token
INTEGRATION_AUTH_URL=https://api.example.com/v1/auth
# Payload to send in the auth POST
INTEGRATION_AUTH_PAYLOAD='{"username": "...", "password": "..."}'
# URL where processed JSON data will be sent
INTEGRATION_DATA_URL=https://api.example.com/v1/data
# URL to notify the start of a bulk Excel/CSV batch (returns a loteId). If unset, batches use loteId="LOCAL" and skip remote dispatch start.
INTEGRATION_BATCH_START_URL=https://api.example.com/v1/batch/start
# Max number of rows sent concurrently to INTEGRATION_DATA_URL during bulk Excel/CSV processing
INTEGRATION_BATCH_CONCURRENCY=5
# Number of rows per "lote" used to compute cantidadLotes sent to startBatch
INTEGRATION_LOTE_SIZE=100

# 8. Multitenant & Docker
# Controla el perfil dinámico que carga esquemas, prompts e identificadores (ej. davibank)
TENANT_PROFILE=default
# Nombre base para aislar red, volúmenes y contenedores en Docker Compose
COMPOSE_PROJECT_NAME=jt
