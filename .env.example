# 1. System Configuration
PORT=3000
NODE_ENV=development

# 2. Infrastructure
DATABASE_URL=postgresql://user:pass@host:port/db
REDIS_HOST=localhost
REDIS_PORT=6379
# Solo usadas por docker-compose.yml para levantar el contenedor de Postgres
# (POSTGRES_USER/PASSWORD/DB) — en local sin Docker no aplican. En
# producción, cambiar DB_PASSWORD del default inseguro ("password").
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=jt_documents

# 3. Paths Configuration
#
# UNIFICADO: la misma variable, con el MISMO nombre, se usa en local
# (pnpm start:dev, sin Docker) y en producción (Docker Compose) — solo
# cambia el VALOR según dónde vivan realmente las carpetas.
#
# - En LOCAL: valores relativos al proyecto están bien (ej. ../ocr-done).
# - En PRODUCCIÓN (Docker): usar rutas ABSOLUTAS del host (ej. /opt/ocr-done).
#   docker-compose.yml monta cada una en "espejo" (host == contenedor, mismo
#   path a ambos lados) — por eso ya NO existen variables "_HOST_PATH"
#   separadas: la ruta de host y la que ve la app son la misma.
# Ver .env.prod (no versionado) para un ejemplo completo de producción.

# Carpetas internas de trabajo (staging transitorio, no requieren ser
# visibles fuera del contenedor — caen bajo el mount ./local:/app/local)
IN_PATH=./local/in
OCR_PATH=./local/ocr
UNSUPPORTED_PATH=./local/unsupported

# Carpetas de salida (deben ser visibles/compartidas fuera del contenedor
# en producción — usar rutas absolutas del host ahí, ver .env.prod)
EXCEL_DESTINATION_PATH=./local/excel-done
OCR_DESTINATION_PATH=./local/ocr-done
# Destino de PDFs cuyo OCR no extrajo texto (escaneos ilegibles), o de
# cualquier documento con error terminal — movidos para revisión manual.
OCR_UNREADABLE_PATH=./local/ocr-unreadable

# Las 4 carpetas de INGESTA (origen de los documentos). Las primeras 3 son
# genéricas (cualquier extensión soportada); la 4ta (MASIVOS) es especial:
# solo recoge Excel/CSV automáticamente — un PDF ahí espera a que su Excel
# lo reclame por nombre (ver MassiveExcelService).
SOURCE_PATH_1=./local/source1
SOURCE_PATH_2=./local/source2
SOURCE_PATH_3=./local/source3
SOURCE_PATH_MASIVOS=./local/masivos

LOCAL_CLIENTS_PATH=./local/data
LOCAL_REPORTS_PATH=./local/reports

# 4. Pipeline Settings
CRON_EXTRACTION_SCHEDULE="*/1 * * * *"
CRON_REPORT_SCHEDULE="0 23 * * *"
ALLOWED_EXTENSIONS=.doc,.pdf,.csv,.png,.jpg,.xls
CSV_CLIENTS_FILE=clients.csv

# 5. AI Services
GCP_PROJECT_ID=project-id
GCP_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=processor-id
GOOGLE_APPLICATION_CREDENTIALS=./secrets/key.json
GEMINI_API_KEY=key
GEMINI_FALLBACK_MODELS="gemini-2.5-flash,gemini-2.5-pro,gemini-2.0-flash"
# Tamaño máximo (MB) para enviar un PDF/imagen inline a Gemini (multimodal).
# Por encima de este umbral se usa Document AI (OCR) como fallback.
GEMINI_INLINE_MAX_MB=15
# Frontera de procesamiento de archivos individuales (PDF/imagen):
#   <= GEMINI_INLINE_MAX_MB  -> Gemini multimodal (inline)
#   <= FILE_MAX_SIZE_MB      -> fallback Document AI (OCR)
#   >  FILE_MAX_SIZE_MB      -> NO SOPORTADO (estado FORMATO_NO_SOPORTADO; se mueve a UNSUPPORTED_PATH)
FILE_MAX_SIZE_MB=20
# Tarifas (USD por 1M de tokens) usadas SOLO por la ruta de prueba /test/gemini-pdf
# para estimar costo. Ajustar para igualar tu medición real.
GEMINI_PRICE_INPUT_PER_1M=0.30
GEMINI_PRICE_OUTPUT_PER_1M=2.50

# 6. Queue Workers & Rate Limits
MODEL_QUEUE_CONCURRENCY=2
MODEL_QUEUE_RPM_LIMIT=15
# Concurrencia de cola_masivos (MasivoProcessor), independiente de cola_ocr
# para que el procesamiento de Excel/CSV no compita por workers con el flujo
# individual de PDFs.
MASIVO_QUEUE_CONCURRENCY=2

# 7. External Integration Settings
# URL to obtain bearer token
INTEGRATION_AUTH_URL=https://api.example.com/v1/auth
# Payload to send in the auth POST
INTEGRATION_AUTH_PAYLOAD='{"username": "...", "password": "..."}'
# URL where processed JSON data will be sent
INTEGRATION_DATA_URL=https://api.example.com/v1/data
# URL to notify the start of a bulk Excel/CSV batch (returns a loteId). If unset, batches use loteId="LOCAL" and skip remote dispatch start.
INTEGRATION_BATCH_START_URL=https://api.example.com/v1/batch/start
# Max number of rows sent concurrently to INTEGRATION_DATA_URL during bulk Excel/CSV processing
INTEGRATION_BATCH_CONCURRENCY=5
# Number of rows per "lote" used to compute cantidadLotes sent to startBatch
INTEGRATION_LOTE_SIZE=100

# 8. Multitenant & Docker
# Controla el perfil dinámico que carga esquemas, prompts e identificadores (ej. davibank)
TENANT_PROFILE=default
# Nombre base para aislar red, volúmenes y contenedores en Docker Compose
COMPOSE_PROJECT_NAME=jt
