generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentState {
  INGRESADO
  EN_COLA_OCR
  PROCESANDO_OCR
  ERROR_OCR
  OCR_UNREADABLE
  EN_COLA_MODELO
  PROCESANDO_MODELO
  MODEL_ERROR
  IA_OK
  FORMATO_NO_SOPORTADO
  DUPLICADO
  PROCESANDO_EXCEL
  EXCEL_OK
  ERROR_EXCEL
}



model Document {
  id        String        @id @default(uuid())
  fileName  String        @map("nombre_archivo")
  md5Hash   String?       @map("hash_md5")
  state     DocumentState @map("estado")
  ocrText   String?       @map("texto_ocr") @db.Text
  jsonModel Json?         @map("json_modelo")

  stateLogs DocumentStateLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([state])
  @@index([createdAt])
  @@index([md5Hash])
  @@map("documents")
}

model DocumentStateLog {
  id            String         @id @default(uuid())
  documentId    String         @map("document_id")
  previousState DocumentState? @map("estado_anterior")
  newState      DocumentState  @map("nuevo_estado")
  document      Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("document_state_logs")
}

model ExcelRecord {
  id         String   @id @default(uuid())
  excelName  String   @map("nombre_excel")
  tipoOficio String   @map("tipo_oficio")
  numeroFila Int      @map("numero_fila")
  payload    Json     @map("payload")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([excelName])
  @@index([tipoOficio])
  @@map("excel_records")
}

model DailySequence {
  date      DateTime @id @map("fecha") @db.Date
  nextValue Int      @default(1) @map("siguiente_valor")

  @@map("daily_sequences")
}
