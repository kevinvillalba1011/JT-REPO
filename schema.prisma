generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentState {
  INGRESADO
  EN_COLA_OCR
  PROCESANDO_OCR
  ERROR_OCR
  EN_COLA_MODELO
  PROCESANDO_MODELO
  MODEL_ERROR
  IA_OK
  FORMATO_NO_SOPORTADO
  // Estado inicial de un Document del flujo masivo (Excel/CSV) antes de que
  // MasivoProcessor lo tome de cola_masivos — la cola dedicada que evita que
  // el procesamiento masivo compita por workers con el flujo individual
  // (cola_ocr). Análogo a EN_COLA_OCR, pero para cola_masivos.
  EN_COLA_MASIVO
  PROCESANDO_EXCEL
  EXCEL_OK
}

// Trazabilidad del envío al servicio externo, como dimensión separada del
// DocumentState principal (que solo describe el resultado de la extracción).
// PENDIENTE = aún no se intentó enviar; ENVIADO = entregado con éxito;
// FALLIDO = se intentó y falló (ver Document.integrationError).
enum IntegrationStatus {
  PENDIENTE
  ENVIADO
  FALLIDO
}



model Document {
  id        String        @id @default(uuid())
  fileName  String        @map("nombre_archivo")
  md5Hash   String?       @map("hash_md5")
  state     DocumentState @map("estado")
  ocrText   String?       @map("texto_ocr") @db.Text
  jsonModel    Json?         @map("json_modelo")
  lotesEnviados Json?        @map("lotes_enviados")

  // Trazabilidad del envío al servicio externo. Campo dedicado, separado del
  // DocumentState principal: IA_OK sigue significando únicamente "extracción
  // exitosa", sin mezclar si el JSON efectivamente llegó al sistema externo.
  integrationStatus IntegrationStatus @default(PENDIENTE) @map("estado_integracion")
  integrationSentAt DateTime?         @map("integracion_enviado_en")
  integrationError  String?           @map("integracion_error") @db.Text

  // Trazabilidad del lote de entrada (carpeta [tipo_oficio]/[YYYYMMDD]/CORTE_[n]/
  // de la que vino este documento). Todas nullable salvo conteoRegistrado
  // porque los documentos históricos (previos a este cambio) no tienen un
  // lote de origen conocido.
  entryReportId     String?      @map("entry_report_id")
  entryReport       EntryReport? @relation(fields: [entryReportId], references: [id])
  // Derivado de la ruta de entrada (carpeta [tipo_oficio]/...), NO de lo que
  // detecta el modelo. Se conserva por separado de tipoOficioIa para poder
  // auditar discrepancias entre "dónde se depositó el archivo" y "qué tipo
  // de oficio identificó realmente Gemini / la hoja del Excel" — si difieren,
  // es señal de que el archivo llegó a la carpeta equivocada.
  tipoOficio        String?      @map("tipo_oficio")
  tipoOficioIa      String?      @map("tipo_oficio_ia")
  fechaEntrada      String?      @map("fecha_entrada")
  corte             String?      @map("corte")
  nombreOficioFinal String?      @map("nombre_oficio_final")
  // Candado de idempotencia: el incremento de numeroDocumentosProcesados /
  // numeroDocumentosError en EntryReport se dispara desde una cola (retries,
  // reprocesos manuales, mensajes duplicados), y sin este flag un mismo
  // documento podría contarse más de una vez. Antes de incrementar el
  // contador del lote se verifica y marca este campo en la misma transacción.
  conteoRegistrado  Boolean      @default(false) @map("conteo_registrado")

  stateLogs DocumentStateLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([state])
  @@index([createdAt])
  @@index([md5Hash])
  @@index([integrationStatus])
  @@index([entryReportId])
  @@map("documents")
}

// Un registro por cada carpeta de lote de entrada
// ([tipo_oficio]/[YYYYMMDD]/CORTE_[n]/). Lleva el conteo de documentos
// leídos en la carpeta vs. los que terminaron procesados OK / en error, para
// poder responder "¿este lote ya se terminó de procesar por completo?" sin
// tener que recorrer el filesystem.
model EntryReport {
  id                         String    @id @default(uuid())
  fechaCreacion              DateTime  @default(now()) @map("fecha_creacion")
  tipoOficio                 String    @map("tipo_oficio")
  fechaEntrada               String    @map("fecha_entrada")
  corte                      String    @map("corte")
  ruta                       String    @map("ruta")
  numeroDocumentosEntrada    Int       @default(0) @map("numero_documentos_entrada")
  numeroDocumentosProcesados Int       @default(0) @map("numero_documentos_procesados")
  numeroDocumentosError      Int       @default(0) @map("numero_documentos_error")
  // reporteGeneradoEn / reporteRuta quedan NULL hasta que el cron que arma el
  // Excel de reportería corre por primera vez para este lote. Sin este par de
  // columnas, ese cron no tendría forma de saber si ya generó el reporte de
  // un lote en un tick anterior y lo regeneraría (y lo re-subiría/reenviaría)
  // en cada ejecución mientras el lote siga "activo".
  reporteGeneradoEn          DateTime? @map("reporte_generado_en")
  reporteRuta                String?   @map("reporte_ruta")

  documents Document[]

  @@unique([tipoOficio, fechaEntrada, corte])
  @@index([fechaEntrada, corte])
  @@map("entry_report")
}

model DocumentStateLog {
  id            String         @id @default(uuid())
  documentId    String         @map("document_id")
  previousState DocumentState? @map("estado_anterior")
  newState      DocumentState  @map("nuevo_estado")
  document      Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("document_state_logs")
}

model ExcelRecord {
  id         String   @id @default(uuid())
  excelName  String   @map("nombre_excel")
  tipoOficio String   @map("tipo_oficio")
  numeroFila Int      @map("numero_fila")
  payload    Json     @map("payload")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([excelName])
  @@index([tipoOficio])
  @@map("excel_records")
}

model DailySequence {
  date      DateTime @id @map("fecha") @db.Date
  nextValue Int      @default(1) @map("siguiente_valor")

  @@map("daily_sequences")
}

// Registro persistente de cada nombreOficioFinal ya asignado (flujo individual
// o masivo), usado para deduplicar contra TODA la historia en DB — no solo
// contra el filesystem del día actual (ver resolverRutaSinColision, que sí
// tiene esa limitación). El constraint UNIQUE en nombreOficioFinal es lo que
// permite que NombreOficioFinalService reserve un nombre de forma atómica
// (INSERT que falla con P2002 si el nombre ya existe, sin ventana de carrera
// entre "verificar" y "guardar"). No se modela como columna de Document ni de
// ExcelRecord porque esta tabla no representa el ciclo de vida de NINGUNO de
// los dos — es la sombrilla de nombres de negocio ya asignados, compartida
// por ambos flujos.
model NombreOficioFinalUsado {
  id                String   @id @default(uuid())
  nombreOficioFinal String   @unique @map("nombre_oficio_final")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("nombres_oficio_final_usados")
}
